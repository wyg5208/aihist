# /etc/cron.d/aihist -- collection, analytics, backups and the weekly digest.
#
# `run-sync` is the only thing that adds events. `ingest-access-log` is the only
# thing that sees the JavaScript-free citation pages being read, and `prune` is
# the only job allowed to delete rows — from four analytics tables and nowhere
# else.
#
# Install:  cp deploy/cron.d/aihist /etc/cron.d/aihist
#           chmod 0644 /etc/cron.d/aihist

SHELL=/bin/bash
PATH=/usr/local/bin:/usr/bin:/bin
MAILTO=""

# Daily at 01:05, the same slot as the Windows task (deploy/windows/register-tasks.ps1).
# The cadence and STALE_AFTER_HOURS in app/api/public.py are one decision: a window
# shorter than the gap reports a healthy site as stale all day, a window longer than
# the gap hides a dead scheduler. Move this line, move that number.
# The trigger is `auto`, so a second firing within two hours is a `not_due` no-op.
5 1 * * * aihist /srv/aihist/deploy/run-sync.sh auto >> /var/log/aihist/sync.log 2>&1

# Nightly compressed dump, 14 day retention.
20 3 * * * aihist /srv/aihist/deploy/backup.sh >> /var/log/aihist/backup.log 2>&1

# Hourly: turn new reverse-proxy lines into crawl_hits. The static reference
# pages carry no JavaScript, so this log is the only evidence they were fetched
# at all — including by GPTBot and friends. Exits 0 when ANALYTICS_LOG_PATH is
# empty or the file is absent, so an unconfigured box writes one skip line per
# hour instead of one failure per hour.
17 * * * * aihist /srv/aihist/deploy/run-cli.sh ingest-access-log >> /var/log/aihist/analytics.log 2>&1

# Weekly (Sunday 04:40): drop rows past their retention window — page_views
# 90d, crawl_hits 120d, api_key_usage 400d, audit_log 730d. Events, sources,
# sync runs and subscribers have no window and are never touched.
40 4 * * 0 aihist /srv/aihist/deploy/run-cli.sh prune >> /var/log/aihist/prune.log 2>&1

# Weekly (Monday 07:10): the one message this box sends to readers. After the
# 01:05 collection, so the week that just ended is complete; a week with no new
# entries exits 0 and sends nothing, because an empty issue is not worth an
# inbox. Exit 1 here means recipients were addressed and none were delivered —
# a broken SMTP password, not a quiet week.
10 7 * * 1 aihist /srv/aihist/deploy/run-cli.sh weekly-digest >> /var/log/aihist/digest.log 2>&1

# Weekly (Sunday 04:50), ten minutes after `prune`: trim the collection ledger.
# Only the append-only trail and `dropped` items past COLLECT_RETENTION_DAYS go;
# admitted / excluded / held rows are the audit evidence behind a published
# entry and are never removed here.
50 4 * * 0 aihist /srv/aihist/deploy/run-cli.sh library-prune >> /var/log/aihist/prune.log 2>&1
