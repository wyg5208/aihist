# /etc/aihist/api.env -- single source of truth for the API process, the cron
# job and the CLI. Read by systemd (EnvironmentFile) and deploy/run-sync.sh.
#
# Install:  cp deploy/api.env.example /etc/aihist/api.env
#           chown root:aihist /etc/aihist/api.env
#           chmod 0640 /etc/aihist/api.env

# --- database -------------------------------------------------------------
# SQLite, one file, no server to run. Use an absolute path so the location does
# not depend on the working directory.
#   Windows: sqlite+aiosqlite:///D:/srv/aihist/data/aihist.db
#   Linux:   sqlite+aiosqlite:////srv/aihist/data/aihist.db
# Switching to Postgres is a one-line change:
#   postgresql+psycopg://aihist:pass@127.0.0.1:5432/aihist
DATABASE_URL=sqlite+aiosqlite:///D:/srv/aihist/data/aihist.db

# --- admin console --------------------------------------------------------
# Generate the two secrets with:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   python -m app.cli hash-password "your long passphrase"
SESSION_SECRET=CHANGE_ME
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=CHANGE_ME
SESSION_MAX_AGE_SECONDS=43200

# --- editorial panel ------------------------------------------------------
# Fail-closed: with no models configured every automatic candidate is held.
#
# One slot per domestic vendor. PROVIDER selects a preset from
# editorial/providers.py (endpoint + default model + that vendor's "do not
# think" switch), so a slot needs only PROVIDER and KEY:
#   deepseek  deepseek-v4-flash   qwen   qwen3.5-plus   glm    glm-4.7
#   kimi      kimi-k3             minimax MiniMax-M3
#
# A blank slot is not part of the panel; at least three judges must stay
# configured, otherwise the panel reports "models" and holds everything.
# A hang guard, not a latency target: one ballot can carry 24 candidates and
# the slowest vendor (glm-4.7) has been measured at 58s.
# Clamped to 5000-120000 by the code.
EDITORIAL_JUDGE_TIMEOUT_MS=90000

EDITORIAL_JUDGE_1_PROVIDER=deepseek
EDITORIAL_JUDGE_1_KEY=CHANGE_ME
EDITORIAL_JUDGE_2_PROVIDER=qwen
EDITORIAL_JUDGE_2_KEY=CHANGE_ME
EDITORIAL_JUDGE_3_PROVIDER=glm
EDITORIAL_JUDGE_3_KEY=CHANGE_ME
EDITORIAL_JUDGE_4_PROVIDER=kimi
EDITORIAL_JUDGE_4_KEY=CHANGE_ME
EDITORIAL_JUDGE_5_PROVIDER=minimax
EDITORIAL_JUDGE_5_KEY=CHANGE_ME

# Optional per-slot override, e.g. a newer model or a self-hosted gateway.
# EDITORIAL_JUDGE_1_MODEL=
# EDITORIAL_JUDGE_1_BASE=
#
# Or one gateway with five distinct models. Per-slot values win where both are
# present, and MODELS is read positionally (slot 1 gets the first entry).
# EDITORIAL_JUDGE_BASE=https://openrouter.ai/api/v1
# EDITORIAL_JUDGE_KEY=CHANGE_ME
# EDITORIAL_JUDGE_MODELS=openai/gpt-4.1-mini,anthropic/claude-3.7-sonnet,google/gemini-2.0-flash,x-ai/grok-3-mini,mistralai/mistral-small-3

# --- optional summary pass ------------------------------------------------
# LLM_API_BASE=
# LLM_API_KEY=
# LLM_MODEL=

# --- runtime --------------------------------------------------------------
# The edge runtime capped a run at 22s; a VPS only needs a hang guard.
RUN_BUDGET_SECONDS=300
FETCH_BUDGET_SECONDS=120
# The front end's canonical origin, not this origin. The subscription confirm
# link (/api/v1/subscribe/confirm) and the referrer classification are built
# from it, so it stays on the domain Vercel serves even when the API answers on
# api.aihist.net. install.ps1 refuses to start with a mismatch.
SITE_ORIGIN=https://aihist.net

# --- analytics ---------------------------------------------------------------
# First-party only: no third-party script, no cookie. Two separate sources are
# counted and never added together — the SPA beacon, and the reverse proxy's
# access log (which is the only thing that sees the scriptless citation pages).
#
# ANALYTICS_ENABLED=false keeps the beacon wired but writes nothing, and the
# endpoint still answers 204. That is the switch to reach for if SQLite starts
# reporting "database is locked" during a long collection run.
ANALYTICS_ENABLED=true
# Mixed into every visitor digest. Empty falls back to SESSION_SECRET; set it
# only to separate the two secrets.
ANALYTICS_SALT=
# Ceiling for the two behaviour tables. The split is fixed in code (page_views
# 90 days, crawl_hits 120): page views identify a person, IP-derived crawl rows
# do not. Lowering this truncates both; raising it past 120 changes nothing.
ANALYTICS_RETENTION_DAYS=180
# Read by the hourly `ingest-access-log` job. Empty shows "未接入" on the
# Traffic page and the job prints one skip line instead of failing.
#   nginx:            /var/log/nginx/aihist.access.log
#   Caddy, full site: D:/srv/aihist/logs/access.log
#   Caddy, API only:  D:/srv/aihist/logs/access.api.log
#
# With the front end on Vercel this box only writes the API log; the citation
# pages are served by the CDN, so their reads no longer reach this file.
ANALYTICS_LOG_PATH=
# nginx | caddy | auto. `auto` sniffs each line, which is right for a single
# proxy; pin it if a log ever mixes both formats.
ANALYTICS_LOG_FORMAT=auto

# --- open data API -----------------------------------------------------------
# Off by default: publishing an API is a commercial decision, not a deployment
# detail. While false, /api/v1/open/* answers 404 — not 403, so the route is not
# even confirmed to exist, and the public application form (/api/v1/open/apply)
# is closed for the same reason: a programme that has not launched should not
# collect requests it cannot honour. Keys are minted in the console (#/keys), or
# by approving an application (#/applications) and printed exactly once.
OPEN_API_ENABLED=false

# --- approval mail -----------------------------------------------------------
# Optional, and only used by the application queue: one plain-text message per
# approved key. With SMTP_HOST empty the approval still mints its key — the
# console then shows the plaintext once for the operator to forward by hand.
#
# 465 = implicit TLS (SMTP_SSL, the default); 587 = STARTTLS, which also needs
# SMTP_STARTTLS=true. SMTP_FROM falls back to SMTP_USER when empty. A send
# failure is reported next to the key, never raised: the credential exists by
# then and the decision must not depend on the mail server.
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=api@aihist.net
# SMTP_STARTTLS=false
