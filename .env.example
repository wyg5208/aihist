# =============================================================================
# AI Chronicle - configuration template
#
# Copy to `.env` and fill in. `.env` is git-ignored; this template is tracked.
# Precedence: real environment variables > `.env`. The server uses the same key
# set through `deploy/api.env`, so one file shape covers local and production.
# =============================================================================

# --- database ---------------------------------------------------------------
# SQLite is the default: one file, no database server to run or start. Prefer an
# absolute path, because a relative one resolves against the working directory.
#   Windows:    sqlite+aiosqlite:///D:/srv/aihist/data/aihist.db
#   Linux:      sqlite+aiosqlite:////srv/aihist/data/aihist.db
# PostgreSQL:   postgresql+psycopg://aihist:pass@127.0.0.1:5432/aihist
DATABASE_URL=sqlite+aiosqlite:///./aihist.db

# --- admin console ----------------------------------------------------------
# Generate both values:
#   python -c "import secrets;print(secrets.token_urlsafe(48))"
#   python -m app.cli hash-password "your passphrase"
# An empty SESSION_SECRET falls back to a hard-coded development value, so it
# must be set on anything reachable from the internet.
SESSION_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD_HASH=
SESSION_MAX_AGE_SECONDS=43200

# --- site -------------------------------------------------------------------
# Used for canonical URLs and citation links.
SITE_ORIGIN=https://aihist.net

# --- editorial panel: five domestic vendors ---------------------------------
# One slot per vendor. PROVIDER selects a preset from editorial/providers.py:
# the endpoint, a default model, and that vendor's own "do not think" switch
# (all five vendors reason by default, which blows the token budget on a JSON
# ballot). A slot therefore needs only PROVIDER and KEY; MODEL / BASE override
# the preset when the vendor ships a new default.
#
# Presets: deepseek | qwen | glm | kimi | minimax
#   deepseek  https://api.deepseek.com                              deepseek-v4-flash
#   qwen      https://dashscope.aliyuncs.com/compatible-mode/v1      qwen3.5-plus
#   glm       https://open.bigmodel.cn/api/paas/v4                   glm-4.7
#   kimi      https://api.moonshot.cn/v1                             kimi-k3
#   minimax   https://api.minimax.cn/v1                              MiniMax-M3
#
# A slot left completely blank is not part of the panel, so a vendor without a
# key can be dropped without switching the rest off. At least three judges must
# stay configured, otherwise the panel reports `models` and holds every
# automatic candidate instead of admitting it unreviewed (fail-closed).
#
# TIMEOUT_MS is clamped to the 5000-120000 range by the code. It is a hang
# guard, not a latency target: one ballot can carry 24 candidates and the
# slowest vendor (glm-4.7) has been measured at 58s.
EDITORIAL_JUDGE_TIMEOUT_MS=90000

EDITORIAL_JUDGE_1_PROVIDER=deepseek
EDITORIAL_JUDGE_1_KEY=

EDITORIAL_JUDGE_2_PROVIDER=qwen
EDITORIAL_JUDGE_2_KEY=

EDITORIAL_JUDGE_3_PROVIDER=glm
EDITORIAL_JUDGE_3_KEY=

EDITORIAL_JUDGE_4_PROVIDER=kimi
EDITORIAL_JUDGE_4_KEY=

EDITORIAL_JUDGE_5_PROVIDER=minimax
EDITORIAL_JUDGE_5_KEY=

# Optional per-slot override, e.g. a newer model or a self-hosted gateway.
# EDITORIAL_JUDGE_1_MODEL=
# EDITORIAL_JUDGE_1_BASE=

# Shorthand for one gateway and one key: fill these instead of the per-slot
# values above. Per-slot values win where both are present, and MODELS is read
# positionally (slot 1 gets the first entry).
# EDITORIAL_JUDGE_BASE=https://openrouter.ai/api/v1
# EDITORIAL_JUDGE_KEY=
# EDITORIAL_JUDGE_MODELS=vendor/model-a,vendor/model-b,vendor/model-c

# --- optional summary rewrite -----------------------------------------------
# Independent of the panel. Without it, admitted events keep their source
# excerpt as the summary.
# LLM_API_BASE=
# LLM_API_KEY=
# LLM_MODEL=

# --- run budget -------------------------------------------------------------
# Guard rails for one collection pass, in seconds.
RUN_BUDGET_SECONDS=300
FETCH_BUDGET_SECONDS=120

# --- analytics ---------------------------------------------------------------
# First-party only: no third-party script, no cookie. The SPA beacon and the
# reverse proxy's access log are counted separately and shown side by side,
# never summed: the log is the only source that sees the 148 citation pages,
# which carry no JavaScript by design.
#
# ANALYTICS_ENABLED=false keeps the beacon wired and writes nothing; the
# endpoint still answers 204. Use it if SQLite reports "database is locked"
# during a long collection run.
ANALYTICS_ENABLED=true
# Mixed into every visitor digest. Empty falls back to SESSION_SECRET; set it
# only to keep the two secrets distinct.
ANALYTICS_SALT=
# Ceiling for the two behaviour tables: page_views 90 days, crawl_hits 120.
# The ratio is fixed in app/analytics/retention.py. Lowering this truncates
# both; raising it past 120 changes nothing.
ANALYTICS_RETENTION_DAYS=180
# Reverse-proxy access log, read by `python -m app.cli ingest-access-log`.
# Empty means the Traffic page shows the log half as "未接入".
#   nginx:  /var/log/nginx/aihist.access.log
#   Caddy:  D:/srv/aihist/logs/access.log
ANALYTICS_LOG_PATH=
# nginx | caddy | auto. `auto` sniffs each line.
ANALYTICS_LOG_FORMAT=auto

# --- open data API -----------------------------------------------------------
# Off by default. While false, /api/v1/open/* answers 404 rather than 403, so a
# programme that has not launched does not confirm the route exists — and the
# public application form at /api/v1/open/apply is closed too.
OPEN_API_ENABLED=false

# --- approval mail -----------------------------------------------------------
# Optional. Only the application queue uses it: one plain-text message carrying
# an approved key. Without SMTP_HOST the key is still issued and the console
# shows the plaintext once for manual forwarding.
#   465 → implicit TLS (default) · 587 → set SMTP_STARTTLS=true
# SMTP_HOST=
# SMTP_PORT=465
# SMTP_USER=
# SMTP_PASSWORD=
# SMTP_FROM=
# SMTP_STARTTLS=false
