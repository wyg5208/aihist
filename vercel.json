{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "cleanUrls": false,
  "rewrites": [
    { "source": "/admin", "destination": "/admin.html" },
    { "source": "/admin/", "destination": "/admin.html" },
    { "source": "/e/:slug([a-z0-9-]+)", "destination": "/e/:slug.html" },
    { "source": "/api/:path*", "destination": "https://api.aihist.net/api/:path*" },
    { "source": "/go/:path*", "destination": "https://api.aihist.net/go/:path*" }
  ],
  "headers": [
    {
      "source": "/assets/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    },
    {
      "source": "/e/:path*",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    },
    {
      "source": "/sitemap.xml",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/sitemap_baidu.txt",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600" }]
    },
    {
      "source": "/visuals/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=2592000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/admin",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin/",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/admin.html",
      "headers": [{ "key": "X-Robots-Tag", "value": "noindex, nofollow" }]
    },
    {
      "source": "/api/:path*",
      "headers": [
        { "key": "CDN-Cache-Control", "value": "no-store" },
        { "key": "x-vercel-enable-rewrite-caching", "value": "0" }
      ]
    },
    {
      "source": "/api/v1/timeline",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=15, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        },
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" }
      ]
    },
    {
      "source": "/api/v1/status",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=15, s-maxage=60, stale-while-revalidate=300"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=60, stale-while-revalidate=300"
        },
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" }
      ]
    },
    {
      "source": "/api/v1/standard",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=3600, stale-while-revalidate=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, s-maxage=3600, stale-while-revalidate=86400"
        },
        { "key": "x-vercel-enable-rewrite-caching", "value": "1" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        { "key": "X-Frame-Options", "value": "SAMEORIGIN" }
      ]
    }
  ]
}
